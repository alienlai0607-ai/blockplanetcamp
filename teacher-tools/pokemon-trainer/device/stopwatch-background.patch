+def verify_sources():
+    manifest=ROOT/'verification/built_source_sha256.json'
+    if not manifest.is_file():raise RuntimeError('缺少編譯來源校驗，請先重新編譯。')
+    expected=json.loads(manifest.read_text())
+    source=ROOT/'firmware/TamaPoke'
+    relevant=lambda path: Path(path).name!='.DS_Store' and not Path(path).name.startswith('._')
+    expected={name:value for name,value in expected.items() if relevant(name)}
+    actual={str(p.relative_to(source)):sha(p) for p in source.rglob('*') if p.is_file() and relevant(p)}
+    if not actual or actual!=expected:raise RuntimeError('原始碼或自繪素材已變更，請先執行 Build_StopWatch.command 重新編譯。')
+
@@ -18,0 +29 @@
