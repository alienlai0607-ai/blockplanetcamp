+class SourceGuard(unittest.TestCase):
+    def test_changed_or_missing_artwork_requires_rebuild(self):
+        with tempfile.TemporaryDirectory() as d:
+            root=Path(d);source=root/'firmware/TamaPoke';source.mkdir(parents=True);(root/'verification').mkdir()
+            artwork=source/'custom_scene_data.cpp';artwork.write_text('old artwork')
+            manifest=root/'verification/built_source_sha256.json'
+            manifest.write_text(json.dumps({'custom_scene_data.cpp':flash.sha(artwork)}))
+            with patch.object(flash,'ROOT',root):
+                flash.verify_sources()
+                artwork.write_text('new artwork')
+                with self.assertRaisesRegex(RuntimeError,'重新編譯'):flash.verify_sources()
+                artwork.unlink()
+                with self.assertRaises(RuntimeError):flash.verify_sources()
+    def test_missing_manifest_requires_rebuild(self):
+        with tempfile.TemporaryDirectory() as d,patch.object(flash,'ROOT',Path(d)):
+            with self.assertRaisesRegex(RuntimeError,'重新編譯'):flash.verify_sources()
+
